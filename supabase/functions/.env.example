# Edge Function secrets for LOCAL development. Copy to supabase/functions/.env
# (gitignored) and fill in yourself; never commit the real file.
# Production: `pnpm exec supabase secrets set TMDB_API_READ_ACCESS_TOKEN=... ACCOUNT_DELETION_HASH_SALT=...`
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase itself.

# TMDB "API Read Access Token" (v4 bearer token) from themoviedb.org → Settings → API.
TMDB_API_READ_ACCESS_TOKEN=
# Optional: override the TMDB API base URL (E2E points this at a mock server).
TMDB_API_BASE_URL=
# Optional: comma-separated browser origins allowed to call the function directly.
CATALOG_ALLOWED_ORIGINS=

# delete-account: random server-only salt (>= 32 chars) for the anonymous audit
# hash in account_deletion_log. Generate it yourself, e.g. `openssl rand -hex 32`.
# The function refuses to delete anything while this is missing.
ACCOUNT_DELETION_HASH_SALT=
