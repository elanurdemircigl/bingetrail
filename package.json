{
  "name": "bingetrail",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@bingetrail/web",
    "dev:web": "node tooling/scripts/with-local-supabase-env.mjs pnpm --filter @bingetrail/web dev",
    "build:web:local": "node tooling/scripts/with-local-supabase-env.mjs pnpm run build:web",
    "security:check:local": "node tooling/scripts/with-local-supabase-env.mjs pnpm run security:check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && pnpm run typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "test": "turbo run test",
    "test:e2e": "node tooling/scripts/with-local-supabase-env.mjs playwright test",
    "test:security": "node --test \"tooling/security/*.test.mjs\"",
    "security:check": "node tooling/security/public-env-check.mjs && node tooling/security/bundle-guard.mjs apps/web/.next/static",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public --fail-on error",
    "db:advisors": "supabase db advisors --local --type all --level info --fail-on warn",
    "db:types": "node tooling/scripts/gen-db-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:sync": "node tooling/scripts/sync-contracts.mjs",
    "contracts:check": "node tooling/scripts/sync-contracts.mjs --check",
    "test:functions": "node tooling/scripts/deno-test.mjs",
    "e2e:cleanup": "node e2e/tmdb-mock/cleanup-cli.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "turbo": "2.11.8",
    "typescript": "catalog:"
  }
}
