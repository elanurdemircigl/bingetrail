# BingeTrail web — copy to .env.local and fill in locally. Never commit .env.local.
#
# ONLY the variables below may use the NEXT_PUBLIC_ prefix (enforced by
# tooling/security/public-env-check.mjs). Everything with NEXT_PUBLIC_ ships to the browser.
#
# NEVER put the Supabase service-role / secret key (sb_secret_...) or the TMDB
# token here. TMDB lives only as a Supabase Edge Function secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). Random string of 32+ characters used to sign the
# HttpOnly password-recovery marker. Generate e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Local dev/E2E scripts generate one per run automatically.
AUTH_COOKIE_SECRET=
