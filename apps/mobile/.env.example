# BingeTrail mobile — copy to .env.local and fill in locally. Never commit .env.local.
#
# ONLY the variables below may use the EXPO_PUBLIC_ prefix (enforced by
# tooling/security/public-env-check.mjs). Everything with EXPO_PUBLIC_ is embedded in the app bundle.
#
# NEVER put the Supabase service-role / secret key (sb_secret_...) or the TMDB
# token here. TMDB lives only as a Supabase Edge Function secret.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
