{
  "name": "@bingetrail/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@bingetrail/api-client": "workspace:*",
    "@bingetrail/db-types": "workspace:*",
    "@bingetrail/i18n": "workspace:*",
    "@bingetrail/shared": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "^5.104.3",
    "aes-js": "3.1.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.5",
    "i18next-icu": "2.5.0",
    "intl-messageformat": "12.1.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.17",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bingetrail/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/aes-js": "3.1.4",
    "@types/jest": "29.5.14",
    "@types/node": "catalog:",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "babel-preset-expo": "~57.0.15",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "catalog:",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|react-navigation|@react-navigation/.*|nativewind|react-native-css-interop|@bingetrail/.*|@supabase/.*|i18next.*|react-i18next|@tanstack/.*|intl-messageformat|@formatjs/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "testTimeout": 20000
  }
}
